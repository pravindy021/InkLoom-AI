import re
from typing import Dict, List, Optional

CLAIM_PATTERNS = [
    (
        re.compile(
            r"\b(?:guarantees?|guaranteed)\s+(?:\d{1,3}%\s+)?(?:success|results?|satisfaction|growth|returns?)\b[^.!?;]{0,80}",
            re.IGNORECASE,
        ),
        "Unverified absolute claim",
        "The content makes a guarantee or outcome claim that may require supporting evidence.",
        0.94,
    ),
    (
        re.compile(r"\b100\s*%\s+guaranteed\b[^.!?;]{0,80}", re.IGNORECASE),
        "Unverified absolute claim",
        "A 100% guarantee is an absolute promotional claim and may require supporting evidence.",
        0.96,
    ),
    (
        re.compile(r"\brisk[- ]free\b", re.IGNORECASE),
        "Potentially unsupported promotional claim",
        "“Risk-free” is an absolute promotional statement; its scope and evidence may need review.",
        0.88,
    ),
    (
        re.compile(r"\bbest in the world\b", re.IGNORECASE),
        "Unsubstantiated superlative",
        "This comparative superlative may need objective, current supporting evidence.",
        0.91,
    ),
    (
        re.compile(
            r"\b(?:completely|totally)\s+(?:eliminates?|removes?)\s+(?:all\s+)?(?:problems?|risks?|issues?)\b",
            re.IGNORECASE,
        ),
        "Unverified absolute claim",
        "This absolute claim implies that all problems or risks are eliminated.",
        0.92,
    ),
]


def check_promotional_claims(text: str) -> List[Dict[str, object]]:
    findings: List[Dict[str, object]] = []
    seen = set()
    for pattern, title, explanation, confidence in CLAIM_PATTERNS:
        for match in pattern.finditer(text):
            key = (match.start(), match.end())
            if key in seen:
                continue
            seen.add(key)
            findings.append(
                {
                    "category": "unsupported_claim",
                    "severity": "high",
                    "title": title,
                    "explanation": explanation,
                    "matched_text": match.group(0).strip(),
                    "suggestion": (
                        "Revise the claim to match verified product information and "
                        "retain evidence for any performance promise."
                    ),
                    "source": "Unsupported promotional claims heuristic",
                    "guideline": "Unsupported promotional claims",
                    "guideline_id": None,
                    "confidence": confidence,
                }
            )
    return findings


def factual_claim_excerpt(text: str) -> Optional[str]:
    candidates = re.finditer(
        r"(?:\b\d+(?:\.\d+)?\s*%|\$[\d,]+|\b\d{4}\b|\baccording to\b|"
        r"\bresearch shows\b|\bstudies show\b|\bscientifically proven\b|"
        r"\bnumber one\b|#1)[^.!?;]{0,100}",
        text,
        re.IGNORECASE,
    )
    match = next(candidates, None)
    return match.group(0).strip() if match else None


def factual_claim_excerpts(text: str) -> List[str]:
    claim_pattern = re.compile(
        r"(?:\d+(?:\.\d+)?\s*%|\$[\d,]+|\b\d{4}\b|\baccording to\b|"
        r"\bresearch shows\b|\bstudies show\b|\bscientifically proven\b|"
        r"\bnumber one\b|#1)",
        re.IGNORECASE,
    )

    instruction_pattern = re.compile(
        r"^\s*(?:(?:rule|guideline|policy)\s*#?\s*\d*\s*[:.)-]\s*|"
        r"(?:never|do not|don't|avoid|must not|should not)\s+"
        r"(?:claim|state|say|promise|advertise|assert|describe|use|write|mention)\b)",
        re.IGNORECASE,
    )

    claims = []
    seen = set()

    for sentence in re.split(r"(?<=[.!?])\s+|\n+", text):
        candidate = sentence.strip()
        normalized = candidate.casefold()

        if (
            candidate
            and claim_pattern.search(candidate)
            and not instruction_pattern.search(candidate)
            and normalized not in seen
        ):
            claims.append(candidate)
            seen.add(normalized)

    return claims
